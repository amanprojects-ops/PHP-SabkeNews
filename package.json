{
    "name": "blog-old-pro",
    "version": "1.0.0",
    "description": "High-performance blog with modern frontend optimizations",
    "scripts": {
        "dev": "npm run build -- --watch",
        "build": "node build.js",
        "build:css": "tailwindcss -i ./src/css/main.css -o ./public/assets/css/style.css --minify",
        "build:js": "esbuild src/js/main.js --bundle --minify --outfile=public/assets/js/bundle.js --target=es2015",
        "optimize:images": "node scripts/optimize-images.js",
        "generate:static": "php scripts/generate-static.php"
    },
    "dependencies": {
        "@tailwindcss/line-clamp": "^0.4.4",
        "tailwindcss": "^3.3.0"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.14",
        "esbuild": "^0.19.0",
        "postcss": "^8.4.27",
        "sharp": "^0.32.5"
    }
}